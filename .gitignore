# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# ---- Env / secrets ----
.env
.env.*
!example.env

# ---- OS ----
.DS_Store

# ---- Project artifacts ----
out/
wandb/

# Checkpoints and logs stay local. The two exceptions are the rejection-sampling
# and self-play outputs: they are the evidence behind every judge-bias claim in
# TODO.md, and re-running them costs an evening of llama-server time.
runs/*
!runs/rejection/
!runs/selfplay/
runs/rejection/*
runs/selfplay/*
runs/distill/*
runs/evals/*
!runs/rejection/*.jsonl
!runs/rejection/*.json
!runs/rejection/*.html
!runs/selfplay/*.jsonl
!runs/distill/*.jsonl
!runs/evals/*.json
# Teacher-generated SFT data: small, and the thing the fine-tune is trained on,
# so it wants to be reviewable in a diff alongside the eval reports.
!runs/distill/
!runs/evals/
*.pt
*.bin
*.safetensors
*.gguf

# Materialized source corpora (arrow shards) — rebuild via
# `python -m nanobeard.dataset_pipeline.sources --source <name>`.
# Ignore each source's contents but NOT the dir, so source.json can be kept
# (git can't re-include a file whose parent dir is excluded).
data/sources/*/*
# ...but keep each source's provenance manifest.
!data/sources/*/source.json

# Tokenizers + recipes + metadata are small text — version them.
# (train.bin/val.bin are already covered by *.bin above.)
!data/**/pirate_bpe.json
!pirate_bpe.json

# ---- Space staging copies (generated by hf/publish_space.py) ----
hf/space/nanobeard/
hf/space/assets/

# ---- HF release staging dir (nanobeard.publish --stage-dir) ----
hf_release/

# ---- IDE ----
.idea/
.vscode/

# ---- vast.ai state ----
.vast_instance
.vast_instance_*

# ---- local Claude Code agent state ----
.claude/

# GGUF/ONNX export artifacts + downloaded models (uploaded to HF, not source)
export/
